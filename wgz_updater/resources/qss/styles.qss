/* ═══════════════════════════════════════════════════════════════════════
   WGZ // GAME UPDATER  ·  Underground Operations Terminal
   ─────────────────────────────────────────────────────────
   Palette
     bg-0  #07070a     bg-1 #0f0f15    bg-2 #16161f    bg-3 #1d1d29
     rule  #24242f     rule+ #393945
     text  #ecece7     text-2 #9d9d9c   text-3 #5e5e62
     LIME  #d8ff3a   ·  ALERT #ff5b3c  ·  COOL #4f7cff
   Type
     display : Bahnschrift, "Inter Tight", "Segoe UI Variable Display"
     body    : "Segoe UI Variable", "Segoe UI", system-ui
     mono    : "Cascadia Mono", "Cascadia Code", Consolas, monospace
   ═══════════════════════════════════════════════════════════════════════ */

* {
    font-family: "Segoe UI Variable", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #ecece7;
    selection-background-color: #d8ff3a;
    selection-color: #07070a;
}

QWidget#MainRoot {
    background: #07070a;
}

/* ─── TITLE BAR ─────────────────────────────────────────────────────── */

QWidget#TitleBar {
    background: #07070a;
    border: none;
    border-bottom: 1px solid #24242f;
}

QLabel#TitleBarLabel {
    font-family: "Bahnschrift", "Inter Tight", "Segoe UI Variable Display", sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1.2px;
    color: #ecece7;
    padding-left: 10px;
}

QLabel#TitleBarSubtitle {
    font-family: "Cascadia Mono", "Cascadia Code", Consolas, monospace;
    font-size: 10px;
    color: #d8ff3a;
    letter-spacing: 0.5px;
    padding-left: 14px;
}

QPushButton#TitleBarButton {
    background: transparent;
    border: none;
    width: 46px;
    height: 32px;
    color: #9d9d9c;
    font-size: 12px;
}
QPushButton#TitleBarButton:hover {
    background: #1d1d29;
    color: #ecece7;
}
QPushButton#TitleBarClose {
    background: transparent;
    border: none;
    width: 46px;
    height: 32px;
    color: #9d9d9c;
    font-size: 12px;
}
QPushButton#TitleBarClose:hover {
    background: #ff5b3c;
    color: #07070a;
}

/* ─── SIDEBAR ───────────────────────────────────────────────────────── */

QFrame#Sidebar {
    background: #0a0a0e;
    border: none;
    border-right: 1px solid #24242f;
}

QPushButton#NavItem {
    text-align: left;
    padding: 14px 18px;
    border: none;
    border-left: 3px solid transparent;
    background: transparent;
    color: #9d9d9c;
    font-family: "Bahnschrift", "Inter Tight", "Segoe UI Variable Display", sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1.2px;
    margin: 0;
}
QPushButton#NavItem:hover {
    background: #14141a;
    color: #ecece7;
}
QPushButton#NavItem:checked {
    background: #14141a;
    color: #d8ff3a;
    border-left: 3px solid #d8ff3a;
}

QLabel#SidebarBrand {
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-weight: 700;
    font-size: 22px;
    letter-spacing: 2px;
    color: #ecece7;
    padding: 18px 18px 4px 18px;
}
QLabel#SidebarTagline {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 9px;
    color: #d8ff3a;
    letter-spacing: 1px;
    padding: 0 18px 14px 18px;
}
QLabel#SidebarSection {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 9px;
    color: #5e5e62;
    letter-spacing: 1.5px;
    padding: 14px 18px 6px 18px;
}

/* ─── STATUS STRIP ──────────────────────────────────────────────────── */

QFrame#StatusStrip {
    background: #0a0a0e;
    border: none;
    border-top: 1px solid #24242f;
}

QLabel#StatusStripTitle {
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.8px;
    color: #ecece7;
}

QLabel#StatusStripDetail {
    font-family: "Cascadia Mono", Consolas, monospace;
    color: #9d9d9c;
    font-size: 11px;
    letter-spacing: 0.4px;
}

/* ─── PROGRESS BAR ──────────────────────────────────────────────────── */

QProgressBar {
    background: #14141a;
    border: 1px solid #24242f;
    border-radius: 0;
    height: 8px;
    text-align: center;
    color: #07070a;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
}
QProgressBar::chunk {
    background: #d8ff3a;
    border-radius: 0;
}

/* ─── BUTTONS ───────────────────────────────────────────────────────── */

QPushButton {
    background: #14141a;
    border: 1px solid #24242f;
    border-radius: 2px;
    padding: 7px 14px;
    color: #ecece7;
    font-weight: 500;
    letter-spacing: 0.3px;
}
QPushButton:hover {
    background: #1d1d29;
    border: 1px solid #393945;
}
QPushButton:pressed {
    background: #0f0f15;
}
QPushButton:disabled {
    color: #5e5e62;
    background: #0f0f15;
    border: 1px solid #1d1d29;
}

QPushButton#Accent {
    background: #d8ff3a;
    border: 1px solid #d8ff3a;
    color: #07070a;
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 8px 18px;
}
QPushButton#Accent:hover {
    background: #ecff7a;
    border: 1px solid #ecff7a;
}
QPushButton#Accent:pressed {
    background: #b8df1a;
}
QPushButton#Accent:disabled {
    background: #1d1d29;
    border: 1px solid #24242f;
    color: #5e5e62;
}

/* ─── LAUNCH-ACTION BUTTON ──────────────────────────────────────────────
   Used for the "🚀 Chạy Game" CTA so it reads as a distinct action from
   the lime "Tải Về / Cập Nhật" button. Cyan signals "ready-to-run /
   active" while lime continues to signal "acquire". Both backgrounds
   keep the same dark foreground for hierarchy parity. */
QPushButton#LaunchAccent {
    background: #5dffe1;
    border: 1px solid #5dffe1;
    color: #07070a;
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 8px 18px;
}
QPushButton#LaunchAccent:hover {
    background: #9fffec;
    border: 1px solid #9fffec;
}
QPushButton#LaunchAccent:pressed {
    background: #2ddfc1;
}
QPushButton#LaunchAccent:disabled {
    background: #1d1d29;
    border: 1px solid #24242f;
    color: #5e5e62;
}

/* ─── INPUTS ────────────────────────────────────────────────────────── */

QLineEdit, QTextEdit, QPlainTextEdit, QComboBox {
    background: #0f0f15;
    border: 1px solid #24242f;
    border-radius: 2px;
    padding: 7px 11px;
    color: #ecece7;
    selection-background-color: #d8ff3a;
    selection-color: #07070a;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus {
    border: 1px solid #d8ff3a;
    background: #0a0a0e;
}
QPlainTextEdit, QTextEdit {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 12px;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #d8ff3a;
    width: 0;
    height: 0;
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    background: #0f0f15;
    border: 1px solid #393945;
    selection-background-color: #1d1d29;
    selection-color: #d8ff3a;
    outline: none;
    padding: 4px;
}

/* ─── TABLES ────────────────────────────────────────────────────────── */

QTableView, QTreeView, QListView {
    background: #07070a;
    border: 1px solid #24242f;
    gridline-color: #14141a;
    selection-background-color: #1d1d29;
    selection-color: #d8ff3a;
    alternate-background-color: #0a0a0e;
    outline: none;
}
QHeaderView::section {
    background: #0a0a0e;
    color: #5e5e62;
    border: none;
    border-bottom: 1px solid #24242f;
    border-right: 1px solid #14141a;
    padding: 9px 14px;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    letter-spacing: 1px;
    font-weight: 700;
    text-transform: uppercase;
}
QTableView::item {
    padding: 9px 14px;
    border: none;
}
QTableView::item:hover {
    background: #14141a;
}

/* ─── SCROLLBARS ────────────────────────────────────────────────────── */

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
    border: none;
}
QScrollBar::handle:vertical {
    background: #393945;
    border-radius: 0;
    min-height: 32px;
}
QScrollBar::handle:vertical:hover {
    background: #d8ff3a;
}
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
    border: none;
}
QScrollBar::handle:horizontal {
    background: #393945;
    border-radius: 0;
    min-width: 32px;
}
QScrollBar::handle:horizontal:hover {
    background: #d8ff3a;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ─── PILLS / STATUS ────────────────────────────────────────────────── */

QLabel#PillInstalled {
    background: transparent;
    color: #4dffaa;
    border: 1px solid #4dffaa;
    border-radius: 0;
    padding: 1px 8px;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}
QLabel#PillUpdate {
    background: transparent;
    color: #ffc04d;
    border: 1px solid #ffc04d;
    border-radius: 0;
    padding: 1px 8px;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}
QLabel#PillNotInstalled {
    background: transparent;
    color: #5e5e62;
    border: 1px solid #393945;
    border-radius: 0;
    padding: 1px 8px;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}

/* ─── DROP ZONE ─────────────────────────────────────────────────────── */

QFrame#DropZone {
    border: 1px dashed #393945;
    border-radius: 0;
    background: #0a0a0e;
}
QFrame#DropZone QLabel {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    color: #5e5e62;
    letter-spacing: 0.5px;
}
QFrame#DropZoneActive {
    border: 1px dashed #d8ff3a;
    background: rgba(216, 255, 58, 0.06);
}

/* ─── TOOLTIPS ──────────────────────────────────────────────────────── */

QToolTip {
    background: #07070a;
    color: #d8ff3a;
    border: 1px solid #393945;
    padding: 5px 9px;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    letter-spacing: 0.4px;
}

/* ─── GAME CARD ─────────────────────────────────────────────────────── */

#GameCard {
    background: #0f0f15;
    border: 1px solid #24242f;
    border-radius: 0;
}
#GameCard:hover {
    background: #14141a;
    border: 1px solid #d8ff3a;
}
#GameCardName {
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: #ecece7;
}
#GameCardMeta {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    color: #5e5e62;
    letter-spacing: 1px;
}

/* ─── HERO IMAGE PLACEHOLDER ────────────────────────────────────────── */

#HeroImage {
    background: #0a0a0e;
    border: 1px solid #24242f;
    border-radius: 0;
    color: #393945;
}

/* ═══════════════════════════════════════════════════════════════════════
   OPERATIONS PAGE  ·  Active Deployment
   ═══════════════════════════════════════════════════════════════════════ */

QWidget#OpsPage {
    background: #07070a;
}

QLabel#OpsOpId {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    color: #393945;
    letter-spacing: 2px;
    font-weight: 700;
}

QLabel#OpsBanner {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    color: #d8ff3a;
    letter-spacing: 2.5px;
}

QFrame#OpsRule {
    background: #24242f;
    border: none;
    max-height: 1px;
}

QLabel#OpsGameTitle {
    font-family: "Bahnschrift", "Inter Tight Condensed", "Inter Tight", sans-serif;
    font-size: 44px;
    font-weight: 800;
    letter-spacing: 1px;
    color: #ffffff;
    line-height: 1.0;
    padding: 4px 0 2px 0;
}

QLabel#OpsPhaseLabel {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    font-weight: 700;
    color: #9d9d9c;
    letter-spacing: 1.8px;
}

QFrame#OpsProgressBox {
    background: #0a0a0e;
    border: 1px solid #24242f;
    border-left: 3px solid #d8ff3a;
    border-radius: 0;
}

QLabel#OpsProgressHeader {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    color: #d8ff3a;
    letter-spacing: 2px;
}

QProgressBar#OpsBar {
    background: #07070a;
    border: 1px solid #1d1d29;
    border-radius: 0;
    height: 20px;
    text-align: center;
}
QProgressBar#OpsBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #b8df1a, stop:1 #d8ff3a);
    border-radius: 0;
}

QLabel#OpsMetricLabel {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 9px;
    color: #5e5e62;
    letter-spacing: 1.5px;
    font-weight: 700;
}

QLabel#OpsMetricValue {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 20px;
    font-weight: 700;
    color: #ecece7;
    letter-spacing: 0.5px;
}

QFrame#OpsMetricSep {
    background: #24242f;
    border: none;
    max-width: 1px;
}

QLabel#OpsStatusText {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    color: #5e5e62;
    letter-spacing: 0.5px;
}

QLabel#OpsLogHeader {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    color: #d8ff3a;
    letter-spacing: 2.5px;
}

QPlainTextEdit#OpsLog {
    background: #050507;
    border: 1px solid #1d1d29;
    border-radius: 0;
    color: #5e5e62;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    padding: 12px 16px;
    selection-background-color: #d8ff3a;
    selection-color: #07070a;
}
QPlainTextEdit#OpsLog:focus {
    border: 1px solid #24242f;
}

QPushButton#AbortButton {
    background: transparent;
    border: 1px solid #ff5b3c;
    border-radius: 0;
    color: #ff5b3c;
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1.2px;
    padding: 10px 24px;
}
QPushButton#AbortButton:hover {
    background: rgba(255, 91, 60, 0.10);
    border-color: #ff7a5e;
    color: #ff7a5e;
}
QPushButton#AbortButton:pressed {
    background: rgba(255, 91, 60, 0.20);
}

/* ─── BACK BUTTON ───────────────────────────────────────────────────── */

#BackButton {
    background: transparent;
    border: none;
    color: #d8ff3a;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
    padding: 4px 0;
    text-align: left;
}
#BackButton:hover {
    color: #ecff7a;
}

/* ─── CHECKBOX ──────────────────────────────────────────────────────── */

QCheckBox {
    color: #9d9d9c;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #393945;
    background: #0a0a0e;
    border-radius: 0;
}
QCheckBox::indicator:checked {
    background: #d8ff3a;
    border: 1px solid #d8ff3a;
}
QCheckBox::indicator:hover {
    border: 1px solid #d8ff3a;
}

/* ─── DIALOG ────────────────────────────────────────────────────────── */

QDialog {
    background: #0a0a0e;
    border: 1px solid #24242f;
}
QMessageBox {
    background: #0a0a0e;
}
QMessageBox QLabel {
    color: #ecece7;
}

/* ─── LOADING DIALOG ────────────────────────────────────────────────── */

QDialog#LoadingDialog {
    background: #0a0a0e;
    border: 1px solid #3a3a4a;
}
QDialog#LoadingDialog QLabel#LoadingDialogLabel {
    color: #ecece7;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.3px;
}
/* Busy bar paints itself via QPainter — no stylesheet needed. */

/* ─── SPLITTER ──────────────────────────────────────────────────────── */

QSplitter::handle {
    background: #14141a;
}
QSplitter::handle:horizontal {
    width: 1px;
}
QSplitter::handle:vertical {
    height: 1px;
}

/* ═══════════════════════════════════════════════════════════════════════
   LIBRARY  ·  Editorial layout (hero + manifest)
   ═══════════════════════════════════════════════════════════════════════ */

QLabel#PageTitle {
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-size: 30px;
    font-weight: 700;
    letter-spacing: 2.5px;
    color: #ecece7;
    padding: 0;
}

QLabel#PageSub {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    color: #5e5e62;
    letter-spacing: 1.4px;
    padding: 2px 0 0 0;
}

QLabel#PageSection {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    color: #5e5e62;
    letter-spacing: 1.5px;
}

QFrame#SectionRule {
    background: #24242f;
    border: none;
    max-height: 1px;
}

QLineEdit#CommandInput {
    background: #07070a;
    border: 1px solid #24242f;
    border-radius: 0;
    padding: 9px 12px;
    color: #d8ff3a;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    letter-spacing: 0.6px;
    selection-background-color: #d8ff3a;
    selection-color: #07070a;
}
QLineEdit#CommandInput:focus {
    border: 1px solid #d8ff3a;
    background: #0a0a0e;
}

/* ─── FEATURED HERO ────────────────────────────────────────────────── */

QFrame#FeaturedHero {
    background: #0a0a0e;
    border: 1px solid #24242f;
    border-radius: 0;
}

QLabel#HeroRibbon {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    color: #d8ff3a;
    letter-spacing: 2px;
    padding-bottom: 4px;
}

QLabel#HeroTag {
    font-family: "Cascadia Mono", Consolas, monospace;
    color: #d8ff3a;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
}

QLabel#HeroTitle {
    font-family: "Bahnschrift", "Inter Tight Condensed", "Inter Tight", sans-serif;
    font-size: 38px;
    font-weight: 800;
    letter-spacing: 0.8px;
    color: #ffffff;
    line-height: 1.0;
}

QLabel#HeroMeta {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    color: #b8b8b3;
    letter-spacing: 1px;
    padding-top: 4px;
}

QPushButton#HeroSecondary {
    background: transparent;
    border: 1px solid #d8ff3a;
    border-radius: 0;
    color: #d8ff3a;
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-weight: 700;
    letter-spacing: 1.2px;
    padding: 8px 18px;
}
QPushButton#HeroSecondary:hover {
    background: rgba(216, 255, 58, 0.12);
}

/* ─── MANIFEST ROW ─────────────────────────────────────────────────── */

QFrame#GameRow {
    background: #0a0a0e;
    border: 1px solid transparent;
    border-left: 2px solid transparent;
    border-radius: 0;
}
QFrame#GameRow:hover {
    background: #14141a;
    border: 1px solid #24242f;
    border-left: 2px solid #d8ff3a;
}

QLabel#RowThumb {
    background: #07070a;
    border: none;
}

QFrame#GameRow QLabel#RowIndex {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 22px;
    font-weight: 700;
    color: #393945;
    letter-spacing: 1px;
}
QFrame#GameRow:hover QLabel#RowIndex {
    color: #d8ff3a;
}

QLabel#RowTitle {
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-size: 17px;
    font-weight: 700;
    color: #ecece7;
    letter-spacing: 0.5px;
    padding: 0;
}

QLabel#RowMeta {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    color: #5e5e62;
    letter-spacing: 1px;
    padding: 0;
}

/* ═══════════════════════════════════════════════════════════════════════
   DETAIL PAGE  ·  Mission Briefing
   ═══════════════════════════════════════════════════════════════════════ */

QFrame#DetailHero {
    background: #0a0a0e;
    border: 1px solid #24242f;
    border-radius: 0;
}

QLabel#DetailHeroTitle {
    font-family: "Bahnschrift", "Inter Tight Condensed", "Inter Tight", sans-serif;
    font-size: 44px;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: #ffffff;
    line-height: 0.95;
    padding: 4px 0 6px 0;
}

QLabel#DetailSectionLabel {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    color: #d8ff3a;
    letter-spacing: 1.6px;
    font-weight: 700;
    padding: 0;
}

QComboBox#DetailCombo {
    background: #0a0a0e;
    border: 1px solid #24242f;
    border-radius: 0;
    padding: 8px 14px;
    color: #ecece7;
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.6px;
}
QComboBox#DetailCombo:focus,
QComboBox#DetailCombo:hover {
    border: 1px solid #d8ff3a;
}
QComboBox#DetailCombo::drop-down {
    border: none;
    width: 32px;
    border-left: 1px solid #24242f;
}
QComboBox#DetailCombo::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #d8ff3a;
    width: 0;
    height: 0;
    margin-right: 10px;
}

QPlainTextEdit#DetailGuide {
    background: #050507;
    border: 1px solid #24242f;
    border-left: 3px solid #d8ff3a;
    border-radius: 0;
    padding: 12px 16px;
    color: #b8b8b3;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 12px;
    line-height: 1.6;
    selection-background-color: #d8ff3a;
    selection-color: #07070a;
}
QPlainTextEdit#DetailGuide:focus {
    border-left: 3px solid #d8ff3a;
    border-top: 1px solid #393945;
    border-right: 1px solid #393945;
    border-bottom: 1px solid #393945;
}

/* ─── TRAILER POPUP (floating overlay on GameDetailPage) ──────────── */

QWidget#TrailerPopup {
    background: #0a0a0e;
    border: 1px solid #24242f;
    border-left: 3px solid #d8ff3a;
}

QWidget#TrailerPopupHeader {
    background: #16161f;
    border-bottom: 1px solid #24242f;
}

QLabel#TrailerPopupTitle {
    color: #d8ff3a;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.4px;
    padding-left: 4px;
}

QWidget#TrailerPopupVideo {
    background: #000000;
}

QPushButton#TrailerCloseBtn {
    background: transparent;
    border: 1px solid transparent;
    color: #b8b8b3;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    font-weight: 700;
    padding: 0;
}
QPushButton#TrailerCloseBtn:hover {
    color: #ff5b3c;
    border: 1px solid #ff5b3c;
}

/* ─── MENU ──────────────────────────────────────────────────────────── */

QMenu {
    background: #0a0a0e;
    border: 1px solid #393945;
    color: #ecece7;
    padding: 4px;
}
QMenu::item {
    padding: 6px 18px;
    background: transparent;
}
QMenu::item:selected {
    background: #14141a;
    color: #d8ff3a;
}
QMenu::separator {
    height: 1px;
    background: #24242f;
    margin: 4px 0;
}

/* ═══════════════════════════════════════════════════════════════════════
   LOGIN WINDOW  ·  Identity Clearance Gate
   ═══════════════════════════════════════════════════════════════════════ */

QWidget#LoginRoot {
    background: #07070a;
}

QWidget#LoginTitleBar {
    background: #07070a;
    border-bottom: 1px solid #24242f;
}

QLabel#LoginTitleLabel {
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: #5e5e62;
    padding-left: 2px;
}

QWidget#LoginLeftPanel {
    background: #0a0a0e;
}

QWidget#LoginRightPanel {
    background: #07070a;
}

QLabel#LoginLogo {
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-size: 80px;
    font-weight: 700;
    letter-spacing: 4px;
    color: #ecece7;
    padding: 0;
    line-height: 1.0;
}

QLabel#LoginLogoSub {
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 4px;
    color: #5e5e62;
    padding: 0 0 0 4px;
}

QFrame#LoginRule {
    background: #d8ff3a;
    border: none;
    max-height: 1px;
}

QLabel#LoginFeatureHeader {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    color: #d8ff3a;
    letter-spacing: 2px;
}

QLabel#LoginFeatureItem {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 12px;
    color: #9d9d9c;
    letter-spacing: 0.8px;
}

QLabel#LoginFooterNote {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 9px;
    color: #393945;
    letter-spacing: 1.5px;
}

QLabel#LoginSectionHeader {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    color: #d8ff3a;
    letter-spacing: 3px;
}

QLabel#LoginHeading {
    font-family: "Bahnschrift", "Inter Tight Condensed", "Inter Tight", sans-serif;
    font-size: 58px;
    font-weight: 800;
    letter-spacing: 2px;
    color: #ffffff;
    line-height: 0.95;
}

QLabel#LoginDesc {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    color: #5e5e62;
    letter-spacing: 0.6px;
    line-height: 1.6;
}

QPushButton#GoogleSignInButton {
    background: transparent;
    border: 1px solid #d8ff3a;
    border-radius: 0;
    color: #d8ff3a;
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 1.5px;
    padding: 0 24px;
    text-align: left;
}
QPushButton#GoogleSignInButton:hover {
    background: rgba(216, 255, 58, 0.08);
    border-color: #ecff7a;
    color: #ecff7a;
}
QPushButton#GoogleSignInButton:pressed {
    background: rgba(216, 255, 58, 0.15);
}
QPushButton#GoogleSignInButton:disabled {
    border-color: #393945;
    color: #393945;
}

QLabel#LoginStatus {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    color: #5e5e62;
    letter-spacing: 1px;
}

QLabel#LoginCursor {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    color: #d8ff3a;
}

QLabel#LoginError {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    color: #ff5b3c;
    letter-spacing: 0.5px;
    background: rgba(255, 91, 60, 0.06);
    border-left: 2px solid #ff5b3c;
    padding: 8px 12px;
}

/* ─── SIDEBAR USER PANEL ────────────────────────────────────────────── */

QFrame#SidebarUserSep {
    background: #1d1d29;
    border: none;
    max-height: 1px;
}

QWidget#UserBadge {
    background: #0a0a0e;
}

QLabel#UserAvatar {
    background: #d8ff3a;
    color: #07070a;
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-size: 16px;
    font-weight: 800;
    border-radius: 17px;
}

QLabel#UserName {
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-size: 13px;
    font-weight: 700;
    color: #ecece7;
    letter-spacing: 0.3px;
}

QLabel#UserEmail {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 9px;
    color: #5e5e62;
    letter-spacing: 0.3px;
}

QPushButton#LogoutButton {
    background: transparent;
    border: 1px solid #24242f;
    border-radius: 0;
    color: #5e5e62;
    font-size: 14px;
    padding: 0;
}
QPushButton#LogoutButton:hover {
    border-color: #ff5b3c;
    color: #ff5b3c;
    background: rgba(255, 91, 60, 0.08);
}

/* ═══════════════════════════════════════════════════════════════════════
   ACCOUNTS · ASSET VAULT
   ─────────────────────────────────────────────────────────────────────
   Single-page master/detail console:
     KPI strip + toolbar  →  TheaterRail (left)  ·  AssetPanel (right)
   Underground Operations aesthetic — acid-lime accents, mono metadata,
   industrial sharp corners (no border-radius).
   ═══════════════════════════════════════════════════════════════════════ */

QWidget#AccountsVault {
    background: #07070a;
}

QWidget#AccountsVault QLabel#PageTitle {
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-size: 30px;
    font-weight: 700;
    letter-spacing: 2.5px;
    color: #ecece7;
}
QWidget#AccountsVault QLabel#PageSub {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    color: #5e5e62;
    letter-spacing: 1.4px;
    padding: 2px 0 0 0;
}

/* ─── KPI tiles ─────────────────────────────────────────────────────── */

QFrame#KpiTile {
    background: #0a0a0e;
    border: 1px solid #1d1d29;
    border-radius: 0;
    min-width: 110px;
}
QLabel#KpiLabel {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 9px;
    font-weight: 700;
    color: #5e5e62;
    letter-spacing: 1.6px;
}
QLabel#KpiValue {
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-size: 22px;
    font-weight: 800;
    color: #ecece7;
    letter-spacing: 1px;
}
QLabel#KpiValueSmall {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    font-weight: 700;
    color: #ecece7;
    letter-spacing: 1.2px;
}

/* Sync dot states */
QLabel#SyncDot {
    border-radius: 0;
    border: 1px solid #1d1d29;
    background: #393945;
}
QLabel#SyncDot[state="idle"] { background: #393945; border: 1px solid #393945; }
QLabel#SyncDot[state="sync"] { background: #4f7cff; border: 1px solid #4f7cff; }
QLabel#SyncDot[state="ok"]   { background: #d8ff3a; border: 1px solid #d8ff3a; }
QLabel#SyncDot[state="err"]  { background: #ff5b3c; border: 1px solid #ff5b3c; }

/* ─── Vault toolbar buttons ─────────────────────────────────────────── */

QPushButton#VaultToolBtn {
    background: transparent;
    border: 1px solid #24242f;
    border-radius: 0;
    color: #ecece7;
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.2px;
    padding: 9px 18px;
}
QPushButton#VaultToolBtn:hover {
    border-color: #393945;
    background: #0f0f15;
}
QPushButton#VaultToolBtn:pressed { background: #07070a; }
QPushButton#VaultToolBtn:disabled {
    color: #393945;
    border-color: #1d1d29;
    background: #0a0a0e;
}

QPushButton#VaultPrimaryBtn {
    background: #d8ff3a;
    border: 1px solid #d8ff3a;
    border-radius: 0;
    color: #07070a;
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.4px;
    padding: 9px 20px;
}
QPushButton#VaultPrimaryBtn:hover {
    background: #ecff7a;
    border: 1px solid #ecff7a;
}
QPushButton#VaultPrimaryBtn:pressed { background: #b8df1a; }
QPushButton#VaultPrimaryBtn:disabled {
    background: #14141a;
    border: 1px solid #1d1d29;
    color: #393945;
}

/* ─── Splitter / frames ─────────────────────────────────────────────── */

QSplitter#VaultSplit::handle {
    background: #14141a;
}

QFrame#RailFrame {
    background: #0a0a0e;
    border: 1px solid #1d1d29;
    border-right: none;
}
QFrame#PanelFrame {
    background: #0a0a0e;
    border: 1px solid #1d1d29;
}

/* ─── Theater Rail ──────────────────────────────────────────────────── */

QWidget#TheaterRail {
    background: transparent;
}

QFrame#RailHeader {
    background: #07070a;
    border: none;
    border-bottom: 1px solid #1d1d29;
}
QLabel#RailTitle {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    color: #d8ff3a;
    letter-spacing: 2.4px;
}

QWidget#RailList {
    background: transparent;
}

QLabel#RailEmpty {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    color: #393945;
    letter-spacing: 1.4px;
    padding: 32px 14px;
}

/* Theater entries */

QFrame#TheaterEntry {
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    border-bottom: 1px solid #14141a;
}
QFrame#TheaterEntry:hover {
    background: #0f0f15;
}
QFrame#TheaterEntry[active="true"] {
    background: #0f0f15;
    border-left: 3px solid #d8ff3a;
}

QLabel#TheaterThumb {
    background: #050507;
    border: 1px solid #1d1d29;
    color: #24242f;
}

QLabel#TheaterName {
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-size: 12px;
    font-weight: 700;
    color: #ecece7;
    letter-spacing: 0.5px;
}
QFrame#TheaterEntry[active="true"] QLabel#TheaterName {
    color: #d8ff3a;
}

QLabel#TheaterServices {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 9px;
    color: #5e5e62;
    letter-spacing: 1.1px;
}

QLabel#TheaterCount {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 13px;
    font-weight: 800;
    color: #5e5e62;
    letter-spacing: 0.5px;
    background: transparent;
    border: 1px solid #1d1d29;
    padding: 2px 0;
}
QFrame#TheaterEntry[active="true"] QLabel#TheaterCount {
    color: #07070a;
    background: #d8ff3a;
    border: 1px solid #d8ff3a;
}
QFrame#TheaterEntry:hover QLabel#TheaterCount {
    color: #ecece7;
    border: 1px solid #393945;
}

/* ─── Asset Panel ───────────────────────────────────────────────────── */

QWidget#AssetPanel {
    background: transparent;
}

QFrame#PanelHeader {
    background: #07070a;
    border: none;
    border-bottom: 1px solid #1d1d29;
}
QLabel#PanelTitle {
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-size: 18px;
    font-weight: 800;
    color: #ecece7;
    letter-spacing: 1.5px;
}
QLabel#PanelMeta {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    color: #d8ff3a;
    letter-spacing: 1.4px;
}

QPushButton#PanelAddBtn {
    background: transparent;
    border: 1px solid #d8ff3a;
    border-radius: 0;
    color: #d8ff3a;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.4px;
    padding: 7px 16px;
}
QPushButton#PanelAddBtn:hover {
    background: rgba(216, 255, 58, 0.10);
    color: #ecff7a;
    border-color: #ecff7a;
}
QPushButton#PanelAddBtn:disabled {
    border-color: #1d1d29;
    color: #393945;
    background: transparent;
}

QWidget#PanelBody {
    background: transparent;
}

QLabel#PanelEmpty {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    color: #393945;
    letter-spacing: 1.4px;
    padding: 32px 24px;
    line-height: 1.8;
}

/* Asset rows */

QFrame#AssetRow {
    background: transparent;
    border: none;
    border-bottom: 1px solid #14141a;
    border-left: 2px solid transparent;
}
QFrame#AssetRow:hover {
    background: #07070a;
    border-left: 2px solid #d8ff3a;
}

QLabel#AssetIndex {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 16px;
    font-weight: 800;
    color: #393945;
    letter-spacing: 0.5px;
}
QFrame#AssetRow:hover QLabel#AssetIndex {
    color: #d8ff3a;
}

QLabel#AssetNick {
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: #ecece7;
    letter-spacing: 0.4px;
}

QLabel#AssetFieldLabel {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 9px;
    font-weight: 700;
    color: #393945;
    letter-spacing: 1.5px;
}

QLabel#AssetFieldValue {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    font-weight: 600;
    color: #b8b8b3;
    letter-spacing: 0.4px;
}

/* Service tags — colored per provider */

QLabel#AssetSvcSteam,
QLabel#AssetSvcRiot,
QLabel#AssetSvcOther {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.4px;
    padding: 2px 8px;
    border-radius: 0;
}
QLabel#AssetSvcSteam {
    background: rgba(79, 124, 255, 0.12);
    color: #6e90ff;
    border: 1px solid rgba(79, 124, 255, 0.32);
}
QLabel#AssetSvcRiot {
    background: rgba(255, 91, 60, 0.12);
    color: #ff7a5e;
    border: 1px solid rgba(255, 91, 60, 0.32);
}
QLabel#AssetSvcOther {
    background: #14141a;
    color: #9d9d9c;
    border: 1px solid #1d1d29;
}

/* Asset row buttons */

QPushButton#AssetMicroBtn {
    background: transparent;
    border: 1px solid #1d1d29;
    border-radius: 0;
    color: #5e5e62;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 5px 6px;
    min-height: 24px;
}
QPushButton#AssetMicroBtn:hover {
    border-color: #d8ff3a;
    color: #d8ff3a;
    background: rgba(216, 255, 58, 0.05);
}
QPushButton#AssetMicroBtn:pressed {
    background: rgba(216, 255, 58, 0.12);
}

QPushButton#AssetLoginBtn {
    background: #d8ff3a;
    border: 1px solid #d8ff3a;
    border-radius: 0;
    color: #07070a;
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.3px;
    padding: 0 14px;
    min-height: 28px;
}
QPushButton#AssetLoginBtn:hover {
    background: #ecff7a;
    border: 1px solid #ecff7a;
}
QPushButton#AssetLoginBtn:pressed {
    background: #b8df1a;
}

QPushButton#AssetDeleteBtn {
    background: transparent;
    border: 1px solid #1d1d29;
    border-radius: 0;
    color: #5e5e62;
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-size: 16px;
    font-weight: 800;
    padding: 0;
    min-height: 24px;
}
QPushButton#AssetDeleteBtn:hover {
    border-color: #ff5b3c;
    color: #ff5b3c;
    background: rgba(255, 91, 60, 0.10);
}
QPushButton#AssetDeleteBtn:pressed {
    background: rgba(255, 91, 60, 0.22);
}

/* ─── Riot Login Progress Dialog ─────────────────────────────────── */

QDialog#RiotLoginDialog {
    background: #07070a;
    border: 1px solid #1d1d29;
}

QFrame#RiotLoginHeader {
    background: #0a0a0d;
    border: none;
    border-bottom: 1px solid #1d1d29;
}
QLabel#RiotLoginTitle {
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-size: 18px;
    font-weight: 800;
    color: #ecece7;
    letter-spacing: 1.5px;
}
QLabel#RiotLoginSub {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    color: #d8ff3a;
    letter-spacing: 1.4px;
}

QFrame#RiotLoginTimerFrame {
    background: transparent;
    border: none;
    border-bottom: 1px solid #14141a;
}
QLabel#RiotLoginClockLabel {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    color: #5e5e62;
    letter-spacing: 1.5px;
}
QLabel#RiotLoginClock {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 22px;
    font-weight: 800;
    color: #ecece7;
    letter-spacing: 1.2px;
}
QLabel#RiotLoginStateChip {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 800;
    color: #07070a;
    background: #d8ff3a;
    border: 1px solid #d8ff3a;
    padding: 4px 10px;
    letter-spacing: 1.5px;
}
QLabel#RiotLoginStateChip[state="ok"] {
    color: #07070a;
    background: #b6ff62;
    border: 1px solid #b6ff62;
}
QLabel#RiotLoginStateChip[state="err"] {
    color: #ecece7;
    background: #ff5b3c;
    border: 1px solid #ff5b3c;
}

QFrame#RiotLoginLogWrap {
    background: transparent;
    border: none;
}
QLabel#RiotLoginLogCaption {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 9px;
    font-weight: 700;
    color: #393945;
    letter-spacing: 1.5px;
}
QPlainTextEdit#RiotLoginLog {
    background: #0a0a0d;
    border: 1px solid #1d1d29;
    border-radius: 0;
    color: #b8b8b3;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    padding: 8px 10px;
    selection-background-color: #d8ff3a;
    selection-color: #07070a;
}

QFrame#RiotLoginFooter {
    background: #0a0a0d;
    border: none;
    border-top: 1px solid #1d1d29;
}
QPushButton#RiotLoginCancelBtn {
    background: transparent;
    border: 1px solid #ff5b3c;
    border-radius: 0;
    color: #ff5b3c;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    padding: 6px 18px;
}
QPushButton#RiotLoginCancelBtn:hover {
    background: rgba(255, 91, 60, 0.12);
    color: #ff8068;
    border-color: #ff8068;
}
QPushButton#RiotLoginCancelBtn:pressed {
    background: rgba(255, 91, 60, 0.22);
}
QPushButton#RiotLoginCancelBtn:disabled {
    border-color: #393945;
    color: #393945;
    background: transparent;
}

/* ─── MANAGER (Tab 4) ──────────────────────────────────────────────── */

QWidget#MgrView { background: #07070a; }

/* Header */
QFrame#MgrHeader { background: transparent; border: none; }
QLabel#MgrTitle {
    font-family: "Bahnschrift", "Inter Tight", "Segoe UI Variable Display", sans-serif;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: #ecece7;
}
QLabel#MgrSubtitle {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    color: #5e5e62;
    letter-spacing: 1px;
    padding-left: 4px;
}

QLabel#MgrStatusChip {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    padding: 5px 10px;
    border: 1px solid #393945;
    color: #5e5e62;
    background: transparent;
}
QLabel#MgrStatusChip[state="clean"] {
    color: #d8ff3a;
    border-color: rgba(216, 255, 58, 0.4);
    background: rgba(216, 255, 58, 0.05);
}
QLabel#MgrStatusChip[state="dirty"] {
    color: #ffb84a;
    border-color: rgba(255, 184, 74, 0.5);
    background: rgba(255, 184, 74, 0.07);
}
QLabel#MgrStatusChip[state="pushing"] {
    color: #4f7cff;
    border-color: rgba(79, 124, 255, 0.55);
    background: rgba(79, 124, 255, 0.08);
}
QLabel#MgrStatusChip[state="error"] {
    color: #ff5b3c;
    border-color: rgba(255, 91, 60, 0.55);
    background: rgba(255, 91, 60, 0.08);
}
QLabel#MgrStatusChip[state="loading"] {
    color: #9d9d9c;
    border-color: #393945;
}

QPushButton#MgrPushBtn {
    background: #d8ff3a;
    border: 1px solid #d8ff3a;
    border-radius: 0;
    color: #07070a;
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 1.4px;
    padding: 8px 18px;
    min-height: 28px;
}
QPushButton#MgrPushBtn:hover { background: #e3ff6b; border-color: #e3ff6b; }
QPushButton#MgrPushBtn:pressed { background: #c4e62d; }
QPushButton#MgrPushBtn:disabled {
    background: transparent;
    color: #393945;
    border-color: #24242f;
}

QPushButton#MgrSecondaryBtn {
    background: transparent;
    border: 1px solid #393945;
    border-radius: 0;
    color: #9d9d9c;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
    padding: 7px 14px;
    min-height: 28px;
}
QPushButton#MgrSecondaryBtn:hover {
    border-color: #d8ff3a;
    color: #d8ff3a;
    background: rgba(216, 255, 58, 0.05);
}
QPushButton#MgrSecondaryBtn:pressed { background: rgba(216, 255, 58, 0.12); }
QPushButton#MgrSecondaryBtn:disabled {
    border-color: #1d1d29;
    color: #393945;
}

/* Tab strip */
QFrame#MgrTabStrip { background: transparent; border: none; border-bottom: 1px solid #24242f; }
QPushButton#MgrTabBtn {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: #5e5e62;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    padding: 10px 22px;
}
QPushButton#MgrTabBtn:hover { color: #9d9d9c; }
QPushButton#MgrTabBtn:checked {
    color: #d8ff3a;
    border-bottom: 2px solid #d8ff3a;
    background: rgba(216, 255, 58, 0.03);
}

/* Editor frame */
QFrame#MgrLeftRail {
    background: #0a0a0e;
    border: 1px solid #1d1d29;
    border-right: none;
}
QFrame#MgrRightHost {
    background: #0f0f15;
    border: 1px solid #1d1d29;
}
QFrame#MgrEditHeader {
    background: #16161f;
    border-bottom: 1px solid #24242f;
}
QLabel#MgrEditTitle {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 12px;
    font-weight: 700;
    color: #ecece7;
    letter-spacing: 1px;
}

/* Section caption */
QLabel#MgrSectionCaption {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    color: #5e5e62;
    letter-spacing: 1.6px;
}

/* Inventory list */
QListWidget#MgrList {
    background: transparent;
    border: 1px solid #1d1d29;
    border-radius: 0;
    color: #ecece7;
    outline: none;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 12px;
    padding: 2px;
}
QListWidget#MgrList::item {
    padding: 8px 6px;
    border-bottom: 1px solid #16161f;
}
QListWidget#MgrList::item:hover { background: #16161f; }
QListWidget#MgrList::item:selected {
    background: rgba(216, 255, 58, 0.08);
    color: #d8ff3a;
    border-left: 2px solid #d8ff3a;
}

/* Inventory tree (grouped by `game` field) */
QTreeWidget#MgrTree {
    background: transparent;
    border: 1px solid #1d1d29;
    border-radius: 0;
    color: #ecece7;
    outline: none;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 12px;
    padding: 0;
    show-decoration-selected: 0;
}
QTreeWidget#MgrTree::item { border: none; padding: 0; }
QTreeWidget#MgrTree::item:selected,
QTreeWidget#MgrTree::item:focus { background: transparent; outline: none; }
QTreeWidget#MgrTree::branch { background: transparent; }

/* Group header row */
QFrame#MgrGroupHeader {
    background: #0c0c12;
    border-bottom: 1px solid #1d1d29;
}
QFrame#MgrGroupHeader:hover { background: #14141c; }
QLabel#MgrGroupChevron {
    color: #5e5e62;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
}
QLabel#MgrGroupName {
    color: #d8ff3a;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.6px;
}
QLabel#MgrGroupCount {
    color: #5e5e62;
    background: #16161f;
    padding: 1px 6px;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    border-radius: 2px;
}
QPushButton#MgrGroupAction {
    background: transparent;
    border: 1px solid #24242f;
    color: #9d9d9c;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    font-weight: 700;
    padding: 0;
    border-radius: 0;
}
QPushButton#MgrGroupAction:hover {
    border-color: #d8ff3a;
    color: #d8ff3a;
}

/* Game child row */
QFrame#MgrChild {
    background: transparent;
    border-bottom: 1px solid #16161f;
    border-left: 2px solid transparent;
}
QFrame#MgrChild:hover { background: #16161f; }
QFrame#MgrChild[selected="true"] {
    background: rgba(216, 255, 58, 0.08);
    border-left: 2px solid #d8ff3a;
}
QLabel#MgrChildIndex {
    color: #5e5e62;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
}
QLabel#MgrChildName {
    color: #ecece7;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 12px;
}
QFrame#MgrChild[selected="true"] QLabel#MgrChildName { color: #d8ff3a; }
QLabel#MgrPartsChip {
    color: #d8ff3a;
    background: rgba(216, 255, 58, 0.10);
    border: 1px solid rgba(216, 255, 58, 0.25);
    padding: 0px 6px;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    border-radius: 2px;
}

/* Form scroll */
QScrollArea#MgrScroll {
    background: #0f0f15;
    border: none;
}
QWidget#MgrFormWrap { background: #0f0f15; }

QLabel#MgrFieldLabel {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    color: #9d9d9c;
    letter-spacing: 1.4px;
}
QLabel#MgrFieldHint {
    font-family: "Segoe UI Variable", sans-serif;
    font-size: 10px;
    color: #5e5e62;
}

QLineEdit#MgrInput {
    background: #07070a;
    border: 1px solid #24242f;
    border-radius: 0;
    color: #ecece7;
    padding: 7px 9px;
    selection-background-color: #d8ff3a;
    selection-color: #07070a;
}
QLineEdit#MgrInput:hover { border-color: #393945; }
QLineEdit#MgrInput:focus { border-color: #d8ff3a; }
QLineEdit#MgrInput:disabled { color: #393945; background: #0a0a0d; border-color: #16161f; }

QPlainTextEdit#MgrTextArea {
    background: #07070a;
    border: 1px solid #24242f;
    border-radius: 0;
    color: #ecece7;
    font-family: "Segoe UI Variable", sans-serif;
    padding: 6px 8px;
    selection-background-color: #d8ff3a;
    selection-color: #07070a;
}
QPlainTextEdit#MgrTextArea:hover { border-color: #393945; }
QPlainTextEdit#MgrTextArea:focus { border-color: #d8ff3a; }

QComboBox#MgrCombo {
    background: #07070a;
    border: 1px solid #24242f;
    border-radius: 0;
    color: #ecece7;
    padding: 6px 9px;
    min-height: 22px;
}
QComboBox#MgrCombo:hover { border-color: #393945; }
QComboBox#MgrCombo:focus { border-color: #d8ff3a; }
QComboBox#MgrCombo::drop-down { width: 22px; border-left: 1px solid #24242f; }
QComboBox#MgrCombo QAbstractItemView {
    background: #0f0f15;
    color: #ecece7;
    border: 1px solid #393945;
    selection-background-color: rgba(216, 255, 58, 0.15);
    selection-color: #d8ff3a;
    outline: none;
}

/* Add / remove */
QPushButton#MgrAddBtn {
    background: transparent;
    border: 1px solid #393945;
    border-radius: 0;
    color: #9d9d9c;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    padding: 4px 10px;
    min-height: 22px;
}
QPushButton#MgrAddBtn:hover {
    border-color: #d8ff3a;
    color: #d8ff3a;
    background: rgba(216, 255, 58, 0.05);
}
QPushButton#MgrAddBtn:pressed { background: rgba(216, 255, 58, 0.12); }

QPushButton#MgrRemoveBtn {
    background: transparent;
    border: 1px solid #24242f;
    border-radius: 0;
    color: #5e5e62;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 12px;
    font-weight: 700;
    min-height: 26px;
}
QPushButton#MgrRemoveBtn:hover {
    border-color: #ff5b3c;
    color: #ff5b3c;
    background: rgba(255, 91, 60, 0.06);
}
QPushButton#MgrRemoveBtn:pressed { background: rgba(255, 91, 60, 0.14); }

QPushButton#MgrDangerBtn {
    background: transparent;
    border: 1px solid #ff5b3c;
    border-radius: 0;
    color: #ff5b3c;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.4px;
    padding: 6px 12px;
    min-height: 26px;
}
QPushButton#MgrDangerBtn:hover { background: rgba(255, 91, 60, 0.12); color: #ff8068; border-color: #ff8068; }
QPushButton#MgrDangerBtn:pressed { background: rgba(255, 91, 60, 0.22); }
QPushButton#MgrDangerBtn:disabled { border-color: #24242f; color: #393945; }

/* URL row index */
QLabel#MgrUrlIndex {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    color: #5e5e62;
    border: 1px solid #1d1d29;
    background: #0a0a0d;
    padding: 4px 0;
}
QFrame#MgrUrlListWrap { background: transparent; }
QFrame#MgrUrlRowsHost { background: transparent; }
QFrame#MgrUrlRow { background: transparent; }

/* ── Manager: collapsible form sections ─────────────────────────── */
QFrame#MgrSection { background: transparent; border-top: 1px solid #16161f; }
QFrame#MgrSectionHeader { background: transparent; }
QFrame#MgrSectionHeader:hover { background: rgba(255, 255, 255, 0.02); }
QLabel#MgrSectionChevron {
    color: #5e5e62;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
}
QLabel#MgrSectionSummary {
    color: #5e5e62;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    padding: 0 4px;
}
QFrame#MgrSectionBody { background: transparent; }

/* ── Header keyboard hint + dirty-count chip ────────────────────── */
QLabel#MgrKbdHint {
    color: #5e5e62;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    padding-left: 10px;
}
QLabel#MgrDirtyCountChip {
    color: #ffd64a;
    background: rgba(255, 214, 74, 0.10);
    border: 1px solid rgba(255, 214, 74, 0.32);
    padding: 4px 10px;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    border-radius: 2px;
}

/* ── Dirty dots + row chip ──────────────────────────────────────── */
QLabel#MgrRowDirtyDot { color: #ffd64a; font-size: 14px; }
QLabel#MgrGroupDirtyDot { color: #ffd64a; font-size: 12px; }
QLabel#MgrRowDirtyChip {
    color: #ffd64a;
    background: rgba(255, 214, 74, 0.10);
    border: 1px solid rgba(255, 214, 74, 0.32);
    padding: 3px 8px;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    border-radius: 2px;
}

/* ── Inline field error label ───────────────────────────────────── */
QLabel#MgrFieldError {
    color: #ff8068;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    padding: 4px 8px;
    background: rgba(255, 91, 60, 0.06);
    border-left: 2px solid #ff5b3c;
}

/* ── Empty state ────────────────────────────────────────────────── */
QLabel#MgrEmptyState {
    color: #5e5e62;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    padding: 24px 12px;
}

/* ── Search bar ─────────────────────────────────────────────────── */
QFrame#MgrSearchWrap {
    background: #07070a;
    border: 1px solid #24242f;
    border-radius: 0;
    min-height: 28px;
}
QFrame#MgrSearchWrap:focus-within { border-color: #d8ff3a; }
QLabel#MgrSearchGlyph {
    color: #5e5e62;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 13px;
}
QLineEdit#MgrSearchInput {
    background: transparent;
    border: none;
    color: #ecece7;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    padding: 6px 0;
    selection-background-color: #d8ff3a;
    selection-color: #07070a;
}
QPushButton#MgrSearchClear {
    background: transparent;
    border: none;
    color: #5e5e62;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    font-weight: 700;
}
QPushButton#MgrSearchClear:hover { color: #ff5b3c; }

/* ── Filter chips ───────────────────────────────────────────────── */
QFrame#MgrFilterWrap { background: transparent; }
QPushButton#MgrFilterChip {
    background: transparent;
    border: 1px solid #24242f;
    border-radius: 0;
    color: #5e5e62;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.2px;
    padding: 3px 8px;
    min-height: 20px;
}
QPushButton#MgrFilterChip:hover { color: #ecece7; border-color: #393945; }
QPushButton#MgrFilterChip:checked {
    color: #d8ff3a;
    border-color: #d8ff3a;
    background: rgba(216, 255, 58, 0.06);
}
QLabel#MgrFilterBadge {
    color: #ffd64a;
    background: rgba(255, 214, 74, 0.10);
    border: 1px solid rgba(255, 214, 74, 0.32);
    padding: 2px 6px;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 9px;
    font-weight: 700;
    border-radius: 2px;
}

/* ── Undo ribbon (toast docked in left rail) ────────────────────── */
QFrame#MgrUndoRibbon {
    background: #1d1d29;
    border: 1px solid #393945;
    border-radius: 2px;
}
QLabel#MgrUndoText {
    color: #ecece7;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
}
QLabel#MgrUndoCountdown {
    color: #5e5e62;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
}
QPushButton#MgrUndoBtn {
    background: transparent;
    border: 1px solid #d8ff3a;
    border-radius: 0;
    color: #d8ff3a;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    padding: 3px 10px;
    min-height: 22px;
}
QPushButton#MgrUndoBtn:hover { background: rgba(216, 255, 58, 0.10); }
QPushButton#MgrUndoBtn:pressed { background: rgba(216, 255, 58, 0.22); }
QPushButton#MgrUndoClose {
    background: transparent;
    border: none;
    color: #5e5e62;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    font-weight: 700;
}
QPushButton#MgrUndoClose:hover { color: #ff5b3c; }

/* ── Hero link strip (cross-tab affordance on Games form) ───────── */
QFrame#MgrHeroLink {
    border: 1px solid #393945;
    border-radius: 2px;
    background: #14141c;
}
QFrame#MgrHeroLink[state="ok"]      { border-color: rgba(216, 255, 58, 0.45); background: rgba(216, 255, 58, 0.04); }
QFrame#MgrHeroLink[state="warn"]    { border-color: rgba(255, 214, 74, 0.55); background: rgba(255, 214, 74, 0.05); }
QFrame#MgrHeroLink[state="missing"] { border-color: rgba(255, 91, 60, 0.55); background: rgba(255, 91, 60, 0.05); }
QLabel#MgrHeroState {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 13px;
    font-weight: 700;
    color: #ecece7;
}
QFrame#MgrHeroLink[state="ok"]      QLabel#MgrHeroState { color: #d8ff3a; }
QFrame#MgrHeroLink[state="warn"]    QLabel#MgrHeroState { color: #ffd64a; }
QFrame#MgrHeroLink[state="missing"] QLabel#MgrHeroState { color: #ff8068; }
QLabel#MgrHeroText {
    color: #c3c3bb;
    font-family: "Segoe UI Variable", sans-serif;
    font-size: 11px;
}
QPushButton#MgrHeroEditBtn {
    background: transparent;
    border: 1px solid #393945;
    border-radius: 0;
    color: #9d9d9c;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    padding: 4px 10px;
    min-height: 22px;
}
QPushButton#MgrHeroEditBtn:hover { color: #d8ff3a; border-color: #d8ff3a; background: rgba(216, 255, 58, 0.06); }

/* ── Push preview dialog ────────────────────────────────────────── */
QDialog#MgrPushDialog { background: #0f0f15; }
QLabel#MgrPushTitle {
    color: #d8ff3a;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.4px;
}
QLabel#MgrPushSubtitle {
    color: #9d9d9c;
    font-family: "Segoe UI Variable", sans-serif;
    font-size: 11px;
}
QLabel#MgrPushStat {
    background: #14141c;
    border: 1px solid #24242f;
    color: #ecece7;
    padding: 6px 12px;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    border-radius: 2px;
}
QLabel#MgrPushStat[kind="added"]    { color: #d8ff3a; border-color: rgba(216, 255, 58, 0.32); }
QLabel#MgrPushStat[kind="modified"] { color: #ffd64a; border-color: rgba(255, 214, 74, 0.32); }
QLabel#MgrPushStat[kind="deleted"]  { color: #ff8068; border-color: rgba(255, 91, 60, 0.32); }
QLabel#MgrPushStat[empty="true"]    { color: #393945; border-color: #1d1d29; }
QScrollArea#MgrPushScroll {
    background: #07070a;
    border: 1px solid #24242f;
}
QWidget#MgrPushBody { background: #07070a; padding: 10px 12px; }
QLabel#MgrPushGroup {
    color: #9d9d9c;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.4px;
    padding-top: 6px;
}
QLabel#MgrPushItem {
    color: #ecece7;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
}
QLabel#MgrPushItem[kind="added"]    { color: #d8ff3a; }
QLabel#MgrPushItem[kind="modified"] { color: #ffd64a; }
QLabel#MgrPushItem[kind="deleted"]  { color: #ff8068; }
QLabel#MgrPushEmpty {
    color: #5e5e62;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    padding: 12px;
}
QDialogButtonBox#MgrPushBtns { background: transparent; }

/* ── Card browser body (Games + Themes) ─────────────────────────── */
QFrame#MgrToolbar { background: transparent; }
QScrollArea#MgrCardScroll { background: transparent; border: none; }
QWidget#MgrCardBody { background: transparent; }

/* ── Group band (Games tab) ─────────────────────────────────────── */
QFrame#MgrGroupBand { background: transparent; }
QFrame#MgrGroupBandHeader {
    background: #1c1d2a;
    border: 1px solid #2a2c3d;
    border-left: 3px solid #d8ff3a;
    padding-left: 8px;
}
QFrame#MgrGroupBandHeader:hover {
    background: #23253a;
    border-left-color: #e3ff6b;
}
QFrame#MgrGroupBandBody { background: transparent; padding-left: 6px; }
QFrame#MgrGroupBand QLabel#MgrGroupName {
    color: #d8ff3a;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.6px;
}
QLabel#MgrGroupSub {
    color: #8f8f96;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    padding-left: 6px;
}
QPushButton#MgrGroupAddBtn {
    background: transparent;
    border: 1px dashed #393945;
    border-radius: 0;
    color: #9d9d9c;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.1px;
    padding: 3px 10px;
    min-height: 22px;
}
QPushButton#MgrGroupAddBtn:hover {
    color: #d8ff3a;
    border-color: #d8ff3a;
    border-style: solid;
    background: rgba(216, 255, 58, 0.06);
}
QPushButton#MgrGroupMenuBtn {
    background: transparent;
    border: 1px solid #24242f;
    border-radius: 0;
    color: #9d9d9c;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 13px;
    font-weight: 700;
    min-height: 22px;
}
QPushButton#MgrGroupMenuBtn:hover { color: #d8ff3a; border-color: #393945; }

/* ── Game card ──────────────────────────────────────────────────── */
QFrame#MgrGameCard {
    background: #0f0f15;
    border: 1px solid #1d1d29;
    border-left: 2px solid transparent;
    border-radius: 2px;
}
QFrame#MgrGameCard:hover {
    background: #14141c;
    border-color: #393945;
    border-left-color: #393945;
}
QFrame#MgrGameCard[dirty="true"] {
    border-left-color: #ffd64a;
}
QLabel#MgrCardDirtyDot { color: #ffd64a; font-size: 14px; }
QLabel#MgrCardId {
    color: #5e5e62;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.1px;
}
QLabel#MgrCardName {
    color: #ecece7;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 13px;
    font-weight: 600;
}
QFrame#MgrGameCard:hover QLabel#MgrCardName { color: #d8ff3a; }
QPushButton#MgrCardEdit {
    background: transparent;
    border: 1px solid #393945;
    border-radius: 0;
    color: #9d9d9c;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    padding: 4px 12px;
    min-height: 24px;
}
QPushButton#MgrCardEdit:hover {
    color: #d8ff3a;
    border-color: #d8ff3a;
    background: rgba(216, 255, 58, 0.06);
}
QPushButton#MgrCardMenu {
    background: transparent;
    border: 1px solid #24242f;
    border-radius: 0;
    color: #9d9d9c;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 14px;
    font-weight: 700;
    min-height: 24px;
}
QPushButton#MgrCardMenu:hover { color: #d8ff3a; border-color: #393945; }

/* ── Meta chips (on cards) ──────────────────────────────────────── */
QLabel#MgrChip {
    background: #07070a;
    border: 1px solid #24242f;
    color: #9d9d9c;
    padding: 2px 8px;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.0px;
    border-radius: 2px;
}
QLabel#MgrChip[kind="version"] { color: #ecece7; border-color: #393945; }
QLabel#MgrChip[kind="type"]    { color: #6b6bff; border-color: rgba(107, 107, 255, 0.32); }
QLabel#MgrChip[kind="parts"]   { color: #d8ff3a; border-color: rgba(216, 255, 58, 0.32); }
QLabel#MgrChip[kind="flag"]    { color: #ffd64a; border-color: rgba(255, 214, 74, 0.32); }
QLabel#MgrChip[kind="tag"]     { color: #ff8068; border-color: rgba(255, 91, 60, 0.32); }

/* ── Theme card ─────────────────────────────────────────────────── */
QFrame#MgrThemeCard {
    background: #0f0f15;
    border: 1px solid #1d1d29;
    border-radius: 2px;
}
QFrame#MgrThemeCard:hover {
    border-color: #393945;
    background: #14141c;
}
QFrame#MgrThemeCard[dirty="true"] { border-color: rgba(255, 214, 74, 0.55); }
QLabel#MgrThemeThumb {
    background: #07070a;
    color: #5e5e62;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.4px;
    border-bottom: 1px solid #1d1d29;
}
QFrame#MgrThemeMeta { background: transparent; }

/* ── Modal dialogs ──────────────────────────────────────────────── */
QDialog#MgrEditDialog { background: #0f0f15; }
QLabel#MgrDialogTitle {
    color: #d8ff3a;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.4px;
}
QLabel#MgrDialogSubtitle {
    color: #9d9d9c;
    font-family: "Segoe UI Variable", sans-serif;
    font-size: 11px;
}
QScrollArea#MgrDialogScroll {
    background: transparent;
    border: none;
}
QDialogButtonBox#MgrDialogBtns { background: transparent; }


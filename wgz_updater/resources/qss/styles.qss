/* ═══════════════════════════════════════════════════════════════════════
   WGZ // GAME UPDATER  ·  Underground Operations Terminal
   ─────────────────────────────────────────────────────────
   Palette
     bg-0  #07070a     bg-1 #0f0f15    bg-2 #16161f    bg-3 #1d1d29
     rule  #24242f     rule+ #393945
     text  #ecece7     text-2 #9d9d9c   text-3 #5e5e62
     LIME  #d8ff3a   ·  ALERT #ff5b3c  ·  COOL #4f7cff
   Type
     display : Bahnschrift, "Inter Tight", "Segoe UI Variable Display"
     body    : "Segoe UI Variable", "Segoe UI", system-ui
     mono    : "Cascadia Mono", "Cascadia Code", Consolas, monospace
   ═══════════════════════════════════════════════════════════════════════ */

* {
    font-family: "Segoe UI Variable", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #ecece7;
    selection-background-color: #d8ff3a;
    selection-color: #07070a;
}

QWidget#MainRoot {
    background: #07070a;
}

/* ─── TITLE BAR ─────────────────────────────────────────────────────── */

QWidget#TitleBar {
    background: #07070a;
    border: none;
    border-bottom: 1px solid #24242f;
}

QLabel#TitleBarLabel {
    font-family: "Bahnschrift", "Inter Tight", "Segoe UI Variable Display", sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1.2px;
    color: #ecece7;
    padding-left: 10px;
}

QLabel#TitleBarSubtitle {
    font-family: "Cascadia Mono", "Cascadia Code", Consolas, monospace;
    font-size: 10px;
    color: #d8ff3a;
    letter-spacing: 0.5px;
    padding-left: 14px;
}

QPushButton#TitleBarButton {
    background: transparent;
    border: none;
    width: 46px;
    height: 32px;
    color: #9d9d9c;
    font-size: 12px;
}
QPushButton#TitleBarButton:hover {
    background: #1d1d29;
    color: #ecece7;
}
QPushButton#TitleBarClose {
    background: transparent;
    border: none;
    width: 46px;
    height: 32px;
    color: #9d9d9c;
    font-size: 12px;
}
QPushButton#TitleBarClose:hover {
    background: #ff5b3c;
    color: #07070a;
}

/* ─── SIDEBAR ───────────────────────────────────────────────────────── */

QFrame#Sidebar {
    background: #0a0a0e;
    border: none;
    border-right: 1px solid #24242f;
}

QPushButton#NavItem {
    text-align: left;
    padding: 14px 18px;
    border: none;
    border-left: 3px solid transparent;
    background: transparent;
    color: #9d9d9c;
    font-family: "Bahnschrift", "Inter Tight", "Segoe UI Variable Display", sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1.2px;
    margin: 0;
}
QPushButton#NavItem:hover {
    background: #14141a;
    color: #ecece7;
}
QPushButton#NavItem:checked {
    background: #14141a;
    color: #d8ff3a;
    border-left: 3px solid #d8ff3a;
}

QLabel#SidebarBrand {
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-weight: 700;
    font-size: 22px;
    letter-spacing: 2px;
    color: #ecece7;
    padding: 18px 18px 4px 18px;
}
QLabel#SidebarTagline {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 9px;
    color: #d8ff3a;
    letter-spacing: 1px;
    padding: 0 18px 14px 18px;
}
QLabel#SidebarSection {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 9px;
    color: #5e5e62;
    letter-spacing: 1.5px;
    padding: 14px 18px 6px 18px;
}

/* ─── STATUS STRIP ──────────────────────────────────────────────────── */

QFrame#StatusStrip {
    background: #0a0a0e;
    border: none;
    border-top: 1px solid #24242f;
}

QLabel#StatusStripTitle {
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.8px;
    color: #ecece7;
}

QLabel#StatusStripDetail {
    font-family: "Cascadia Mono", Consolas, monospace;
    color: #9d9d9c;
    font-size: 11px;
    letter-spacing: 0.4px;
}

/* ─── PROGRESS BAR ──────────────────────────────────────────────────── */

QProgressBar {
    background: #14141a;
    border: 1px solid #24242f;
    border-radius: 0;
    height: 8px;
    text-align: center;
    color: #07070a;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
}
QProgressBar::chunk {
    background: #d8ff3a;
    border-radius: 0;
}

/* ─── BUTTONS ───────────────────────────────────────────────────────── */

QPushButton {
    background: #14141a;
    border: 1px solid #24242f;
    border-radius: 2px;
    padding: 7px 14px;
    color: #ecece7;
    font-weight: 500;
    letter-spacing: 0.3px;
}
QPushButton:hover {
    background: #1d1d29;
    border: 1px solid #393945;
}
QPushButton:pressed {
    background: #0f0f15;
}
QPushButton:disabled {
    color: #5e5e62;
    background: #0f0f15;
    border: 1px solid #1d1d29;
}

QPushButton#Accent {
    background: #d8ff3a;
    border: 1px solid #d8ff3a;
    color: #07070a;
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 8px 18px;
}
QPushButton#Accent:hover {
    background: #ecff7a;
    border: 1px solid #ecff7a;
}
QPushButton#Accent:pressed {
    background: #b8df1a;
}
QPushButton#Accent:disabled {
    background: #1d1d29;
    border: 1px solid #24242f;
    color: #5e5e62;
}

/* ─── INPUTS ────────────────────────────────────────────────────────── */

QLineEdit, QTextEdit, QPlainTextEdit, QComboBox {
    background: #0f0f15;
    border: 1px solid #24242f;
    border-radius: 2px;
    padding: 7px 11px;
    color: #ecece7;
    selection-background-color: #d8ff3a;
    selection-color: #07070a;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus {
    border: 1px solid #d8ff3a;
    background: #0a0a0e;
}
QPlainTextEdit, QTextEdit {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 12px;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #d8ff3a;
    width: 0;
    height: 0;
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    background: #0f0f15;
    border: 1px solid #393945;
    selection-background-color: #1d1d29;
    selection-color: #d8ff3a;
    outline: none;
    padding: 4px;
}

/* ─── TABLES ────────────────────────────────────────────────────────── */

QTableView, QTreeView, QListView {
    background: #07070a;
    border: 1px solid #24242f;
    gridline-color: #14141a;
    selection-background-color: #1d1d29;
    selection-color: #d8ff3a;
    alternate-background-color: #0a0a0e;
    outline: none;
}
QHeaderView::section {
    background: #0a0a0e;
    color: #5e5e62;
    border: none;
    border-bottom: 1px solid #24242f;
    border-right: 1px solid #14141a;
    padding: 9px 14px;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    letter-spacing: 1px;
    font-weight: 700;
    text-transform: uppercase;
}
QTableView::item {
    padding: 9px 14px;
    border: none;
}
QTableView::item:hover {
    background: #14141a;
}

/* ─── SCROLLBARS ────────────────────────────────────────────────────── */

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
    border: none;
}
QScrollBar::handle:vertical {
    background: #393945;
    border-radius: 0;
    min-height: 32px;
}
QScrollBar::handle:vertical:hover {
    background: #d8ff3a;
}
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
    border: none;
}
QScrollBar::handle:horizontal {
    background: #393945;
    border-radius: 0;
    min-width: 32px;
}
QScrollBar::handle:horizontal:hover {
    background: #d8ff3a;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ─── PILLS / STATUS ────────────────────────────────────────────────── */

QLabel#PillInstalled {
    background: transparent;
    color: #4dffaa;
    border: 1px solid #4dffaa;
    border-radius: 0;
    padding: 1px 8px;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}
QLabel#PillUpdate {
    background: transparent;
    color: #ffc04d;
    border: 1px solid #ffc04d;
    border-radius: 0;
    padding: 1px 8px;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}
QLabel#PillNotInstalled {
    background: transparent;
    color: #5e5e62;
    border: 1px solid #393945;
    border-radius: 0;
    padding: 1px 8px;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}

/* ─── DROP ZONE ─────────────────────────────────────────────────────── */

QFrame#DropZone {
    border: 1px dashed #393945;
    border-radius: 0;
    background: #0a0a0e;
}
QFrame#DropZone QLabel {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    color: #5e5e62;
    letter-spacing: 0.5px;
}
QFrame#DropZoneActive {
    border: 1px dashed #d8ff3a;
    background: rgba(216, 255, 58, 0.06);
}

/* ─── TOOLTIPS ──────────────────────────────────────────────────────── */

QToolTip {
    background: #07070a;
    color: #d8ff3a;
    border: 1px solid #393945;
    padding: 5px 9px;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    letter-spacing: 0.4px;
}

/* ─── GAME CARD ─────────────────────────────────────────────────────── */

#GameCard {
    background: #0f0f15;
    border: 1px solid #24242f;
    border-radius: 0;
}
#GameCard:hover {
    background: #14141a;
    border: 1px solid #d8ff3a;
}
#GameCardName {
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: #ecece7;
}
#GameCardMeta {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    color: #5e5e62;
    letter-spacing: 1px;
}

/* ─── HERO IMAGE PLACEHOLDER ────────────────────────────────────────── */

#HeroImage {
    background: #0a0a0e;
    border: 1px solid #24242f;
    border-radius: 0;
    color: #393945;
}

/* ─── SERVICE CARD (Accounts) ───────────────────────────────────────── */

#ServiceCard {
    background: #0f0f15;
    border: 1px solid #24242f;
    border-radius: 0;
    min-width: 150px;
}
#ServiceCard:hover {
    background: #14141a;
    border: 1px solid #d8ff3a;
}
#ServiceCardName {
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.6px;
    color: #ecece7;
}
#ServiceCardCount {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    color: #d8ff3a;
    letter-spacing: 0.8px;
}

/* ─── DOWNLOAD PROGRESS PAGE ────────────────────────────────────────── */

#ProgressPage {
    background: transparent;
}
#ProgressPage QProgressBar {
    min-height: 14px;
    border: 1px solid #24242f;
    border-radius: 0;
    background: #07070a;
}
#ProgressPage QProgressBar::chunk {
    background: #d8ff3a;
}

/* ─── ACCOUNT ROW ───────────────────────────────────────────────────── */

#AccountRow {
    background: #0f0f15;
    border: 1px solid #24242f;
    border-radius: 0;
    padding: 6px;
}
#AccountRow:hover {
    background: #14141a;
    border: 1px solid #393945;
}
#AccountNickname {
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-size: 13px;
    font-weight: 700;
    color: #ecece7;
    letter-spacing: 0.4px;
}
#AccountMeta {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    color: #5e5e62;
    letter-spacing: 0.6px;
}

/* ─── BACK BUTTON ───────────────────────────────────────────────────── */

#BackButton {
    background: transparent;
    border: none;
    color: #d8ff3a;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
    padding: 4px 0;
    text-align: left;
}
#BackButton:hover {
    color: #ecff7a;
}

/* ─── CHECKBOX ──────────────────────────────────────────────────────── */

QCheckBox {
    color: #9d9d9c;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #393945;
    background: #0a0a0e;
    border-radius: 0;
}
QCheckBox::indicator:checked {
    background: #d8ff3a;
    border: 1px solid #d8ff3a;
}
QCheckBox::indicator:hover {
    border: 1px solid #d8ff3a;
}

/* ─── DIALOG ────────────────────────────────────────────────────────── */

QDialog {
    background: #0a0a0e;
    border: 1px solid #24242f;
}
QMessageBox {
    background: #0a0a0e;
}
QMessageBox QLabel {
    color: #ecece7;
}

/* ─── SPLITTER ──────────────────────────────────────────────────────── */

QSplitter::handle {
    background: #14141a;
}
QSplitter::handle:horizontal {
    width: 1px;
}
QSplitter::handle:vertical {
    height: 1px;
}

/* ═══════════════════════════════════════════════════════════════════════
   LIBRARY  ·  Editorial layout (hero + manifest)
   ═══════════════════════════════════════════════════════════════════════ */

QLabel#PageTitle {
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-size: 30px;
    font-weight: 700;
    letter-spacing: 2.5px;
    color: #ecece7;
    padding: 0;
}

QLabel#PageSub {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    color: #5e5e62;
    letter-spacing: 1.4px;
    padding: 2px 0 0 0;
}

QLabel#PageSection {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    color: #5e5e62;
    letter-spacing: 1.5px;
}

QFrame#SectionRule {
    background: #24242f;
    border: none;
    max-height: 1px;
}

QLineEdit#CommandInput {
    background: #07070a;
    border: 1px solid #24242f;
    border-radius: 0;
    padding: 9px 12px;
    color: #d8ff3a;
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    letter-spacing: 0.6px;
    selection-background-color: #d8ff3a;
    selection-color: #07070a;
}
QLineEdit#CommandInput:focus {
    border: 1px solid #d8ff3a;
    background: #0a0a0e;
}

/* ─── FEATURED HERO ────────────────────────────────────────────────── */

QFrame#FeaturedHero {
    background: #0a0a0e;
    border: 1px solid #24242f;
    border-radius: 0;
}

QLabel#HeroRibbon {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    color: #d8ff3a;
    letter-spacing: 2px;
    padding-bottom: 4px;
}

QLabel#HeroTag {
    font-family: "Cascadia Mono", Consolas, monospace;
    color: #d8ff3a;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
}

QLabel#HeroTitle {
    font-family: "Bahnschrift", "Inter Tight Condensed", "Inter Tight", sans-serif;
    font-size: 38px;
    font-weight: 800;
    letter-spacing: 0.8px;
    color: #ffffff;
    line-height: 1.0;
}

QLabel#HeroMeta {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    color: #b8b8b3;
    letter-spacing: 1px;
    padding-top: 4px;
}

QPushButton#HeroSecondary {
    background: transparent;
    border: 1px solid #d8ff3a;
    border-radius: 0;
    color: #d8ff3a;
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-weight: 700;
    letter-spacing: 1.2px;
    padding: 8px 18px;
}
QPushButton#HeroSecondary:hover {
    background: rgba(216, 255, 58, 0.12);
}

/* ─── MANIFEST ROW ─────────────────────────────────────────────────── */

QFrame#GameRow {
    background: #0a0a0e;
    border: 1px solid transparent;
    border-left: 2px solid transparent;
    border-radius: 0;
}
QFrame#GameRow:hover {
    background: #14141a;
    border: 1px solid #24242f;
    border-left: 2px solid #d8ff3a;
}

QLabel#RowThumb {
    background: #07070a;
    border: none;
}

QLabel#RowIndex {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 22px;
    font-weight: 700;
    color: #393945;
    letter-spacing: 1px;
}
QFrame#GameRow:hover QLabel#RowIndex {
    color: #d8ff3a;
}

QLabel#RowTitle {
    font-family: "Bahnschrift", "Inter Tight", sans-serif;
    font-size: 17px;
    font-weight: 700;
    color: #ecece7;
    letter-spacing: 0.5px;
    padding: 0;
}

QLabel#RowMeta {
    font-family: "Cascadia Mono", Consolas, monospace;
    font-size: 10px;
    color: #5e5e62;
    letter-spacing: 1px;
    padding: 0;
}

/* ─── MENU ──────────────────────────────────────────────────────────── */

QMenu {
    background: #0a0a0e;
    border: 1px solid #393945;
    color: #ecece7;
    padding: 4px;
}
QMenu::item {
    padding: 6px 18px;
    background: transparent;
}
QMenu::item:selected {
    background: #14141a;
    color: #d8ff3a;
}
QMenu::separator {
    height: 1px;
    background: #24242f;
    margin: 4px 0;
}
